{
"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
"name": "rapid-ads-api",
"main": "index.js",
"compatibility_date": "2026-10-23",

"kv_namespaces": [
{
"binding": "RAPID_ADS_BALANCES",
"id": "9335d0345de1406da1a65818138d320c"
}
],

"d1_databases": [
{
"binding": "RAPID_ADS_DB",
"database_name": "rapid-ads-db",
"database_id": "a243e9bd-06b7-4a10-8d79-3611b674577a"
}
],

"migrations": [
{
"tag": "v1",
"new_sqlite_classes": [
"MonetagRewardCoordinator"
]
}
],

"observability": {
"logs": {
"enabled": true,
"head_sampling_rate": 1,
"invocation_logs": true,
"persist": true
}
}
}
